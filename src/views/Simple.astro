---
/**
 * Kleinere Seiten mit wenig eigener Logik: Transparenz, Mitmachen, Kontakt, Impressum, Datenschutz.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Todo from '../components/Todo.astro';
import { links, org, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  page: 'transparency' | 'join' | 'contact' | 'imprint' | 'privacy';
}
const { lang, page } = Astro.props;
const de = lang === 'de';

const titles = {
  transparency: de ? 'Transparenz' : 'Transparency',
  join: de ? 'Mitmachen' : 'Get involved',
  contact: de ? 'Kontakt' : 'Contact',
  imprint: de ? 'Impressum' : 'Imprint',
  privacy: de ? 'Datenschutz' : 'Privacy policy',
};
const title = titles[page];
---

<BaseLayout lang={lang} title={title} routeKey={page}>
  {
    page === 'transparency' && (
      <>
        <PageHero
          title={title}
          lead={de
            ? 'Wir gehen sorgsam mit jedem Euro um und zeigen offen, wie wir arbeiten.'
            : 'We handle every euro with care and are open about how we work.'}
        />
        <section class="section">
          <div class="container narrow">
            <h2>{de ? 'Dokumente' : 'Documents'}</h2>
            <ul class="docs">
              <li>{de ? 'Jahresbericht 2025' : 'Annual report 2025'}</li>
              <li>{de ? 'Mittelverwendung' : 'Use of funds'}</li>
              <li>{de ? 'Satzung' : 'Statutes'}</li>
              <li>{de ? 'Freistellungsbescheid (Gemeinnützigkeit)' : 'Tax-exemption notice (non-profit status)'}</li>
            </ul>
            <Todo>{de ? 'PDFs und Vereinsregisternummer vom Vorstand.' : 'PDFs and register number from the board.'}</Todo>
            <h2>{de ? 'Spenden über betterplace.org' : 'Donations via betterplace.org'}</h2>
            <p>
              {de
                ? 'Unser Projekt auf betterplace.org zeigt laufend, wofür Spenden eingesetzt werden.'
                : 'Our project page on betterplace.org shows what donations are used for.'}{' '}
              <a href={links.betterplace} rel="noopener">{de ? 'Zum Projekt' : 'View project'}</a>
            </p>
          </div>
        </section>
      </>
    )
  }

  {
    page === 'join' && (
      <>
        <PageHero
          title={de ? 'Mach mit!' : 'Join in!'}
          lead={de
            ? 'Ob Ehrenamt, Schulaktion oder Aktion mit deinem Unternehmen – es gibt viele Wege, Bildungschancen zu schaffen.'
            : 'Volunteering, a school campaign or a company initiative – there are many ways to create educational opportunities.'}
        />
        <section class="section">
          <div class="container grid grid--2 ways">
            <div>
              <h2>{de ? 'Ehrenamt in Deutschland' : 'Volunteer in Germany'}</h2>
              <p>{de ? 'Unser Team arbeitet von verschiedenen Orten aus zusammen – Kommunikation, Fundraising, Events, Design oder Finanzen. Schreib uns, was du kannst und worauf du Lust hast.' : 'Our team works together from different places – communications, fundraising, events, design or finance. Tell us what you can do and what you enjoy.'}</p>
              <a class="btn btn--primary" href={`mailto:${links.email}?subject=Ehrenamt`}>{de ? 'Schreib uns' : 'Email us'}</a>
            </div>
            <div>
              <h2>{de ? 'Schulen & Gruppen' : 'Schools & groups'}</h2>
              <p>{de ? 'Die Pelzl-Schulen in Schweinfurt sammeln mit Schulläufen und Kuchenverkäufen für unsere Kids. Wir helfen euch, eure eigene Aktion zu planen.' : 'The Pelzl schools in Schweinfurt raise money for our kids with charity runs and bake sales. We help you plan your own campaign.'}</p>
              <a class="btn btn--primary" href={`mailto:${links.email}?subject=Schulaktion`}>{de ? 'Aktion anfragen' : 'Plan a campaign'}</a>
            </div>
            <div>
              <h2>{de ? 'Unternehmen & Gastro' : 'Businesses'}</h2>
              <p>{de ? 'Mit „MAINZ FÜR SMILES“ legen Mainzer Lokale Bierdeckel mit QR-Code zur Spendenseite aus. Sprecht uns an, wenn ihr mitmachen wollt.' : 'With “MAINZ FÜR SMILES”, bars in Mainz hand out coasters with a QR code to our donation page. Get in touch if you would like to join.'}</p>
              <a class="btn btn--primary" href={`mailto:${links.email}?subject=Kooperation`}>{de ? 'Kontakt aufnehmen' : 'Get in touch'}</a>
            </div>
            <div>
              <h2>{de ? 'Volunteering in Kenia' : 'Volunteer in Kenya'}</h2>
              <p>{de ? 'Unsere Schwesterorganisation Smiles Africa Experience, gegründet von Peter Mwashi Litonde, vermittelt Freiwillige an passende Projekte in Nairobi – mit Fokus auf gegenseitigem Lernen statt Voluntourism.' : 'Our sister organisation Smiles Africa Experience, founded by Peter Mwashi Litonde, matches volunteers with suitable projects in Nairobi – focused on learning from each other, not voluntourism.'}</p>
              <a class="btn btn--ghost" href="https://www.smilesafricaexperience.com" rel="noopener">Smiles Africa Experience</a>
            </div>
          </div>
        </section>
      </>
    )
  }

  {
    page === 'contact' && (
      <>
        <PageHero title={de ? 'Sprich uns an!' : 'Get in touch!'} lead={de ? 'Fragen zu Spenden, Kooperationen oder Presse? Wir freuen uns auf deine Nachricht.' : 'Questions about donations, partnerships or press? We look forward to hearing from you.'}>
          <div class="actions">
            <a class="btn btn--dark" href={`mailto:${links.email}`}>{links.email}</a>
          </div>
        </PageHero>
        <section class="section">
          <div class="container grid grid--2">
            <div>
              <h2>{de ? 'Deutschland' : 'Germany'}</h2>
              <p>{org.name}<br />{org.street}<br />{org.city}</p>
            </div>
            <div>
              <h2>{de ? 'Kenia' : 'Kenya'}</h2>
              <p>{org.kenya.name}<br />{org.kenya.contact}<br />{org.kenya.address}</p>
            </div>
          </div>
          <div class="container">
            <Todo>{de ? 'Kontaktformular mit Themenauswahl (F-19) – braucht einen Formular-Dienst, da die Seite statisch ist.' : 'Contact form (F-19) – needs a form service because the site is static.'}</Todo>
          </div>
        </section>
      </>
    )
  }

  {
    page === 'imprint' && (
      <section class="section">
        <div class="container narrow prose">
          <h1>{title}</h1>
          <h2>{de ? 'Angaben gemäß § 5 DDG' : 'Information according to § 5 DDG'}</h2>
          <p>{org.name}<br />{org.street}<br />{org.city}</p>
          <p>E-Mail: <a href={`mailto:${links.email}`}>{links.email}</a></p>
          <Todo>{de ? 'Vereinsregister (Amtsgericht, Nummer) und vertretungsberechtigter Vorstand ergänzen; Verantwortliche nach § 18 Abs. 2 MStV benennen; juristisch prüfen.' : 'Add register court and number, authorised board members and the person responsible under § 18 (2) MStV; legal review.'}</Todo>
        </div>
      </section>
    )
  }

  {
    page === 'privacy' && (
      <section class="section">
        <div class="container narrow prose">
          <h1>{title}</h1>
          <p>{de ? 'Diese Website setzt keine Cookies und lädt ohne deine Einwilligung keine Inhalte von Drittanbietern. Schriften werden lokal ausgeliefert.' : 'This website sets no cookies and loads no third-party content without your consent. Fonts are served locally.'}</p>
          <h2>YouTube</h2>
          <p>{de ? 'Videos werden erst nach einem Klick über youtube-nocookie.com (Google Ireland Ltd.) geladen. Dabei werden Daten wie deine IP-Adresse an Google übertragen.' : 'Videos are only loaded from youtube-nocookie.com (Google Ireland Ltd.) after you click. Data such as your IP address is then transferred to Google.'}</p>
          <h2>{de ? 'Spenden über betterplace.org' : 'Donations via betterplace.org'}</h2>
          <p>{de ? 'Für Spenden wirst du zu betterplace.org weitergeleitet. Dort gilt die Datenschutzerklärung von betterplace.' : 'For donations you are redirected to betterplace.org, whose privacy policy applies there.'}</p>
          <Todo label={de ? 'Entwurf' : 'Draft'}>{de ? 'Vollständige Datenschutzerklärung (Verantwortlicher, Hosting bei one.com, Server-Logs, Rechte der Betroffenen) erstellen und juristisch prüfen.' : 'Write the full privacy policy (controller, hosting at one.com, server logs, data subject rights) and have it reviewed.'}</Todo>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .docs {
    padding-left: 1.2em;
  }

  .ways > div {
    background: var(--white);
    border: 2px solid var(--black);
    border-radius: var(--radius);
    padding: 24px;
    height: 100%;
  }

  .ways {
    align-items: stretch;
  }
</style>

---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DonateBand from '../components/DonateBand.astro';
import { formatDate, postLang, type Post } from '../lib/blog';
import { t, url } from '../i18n/ui';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const lang = postLang(post);
const { Content } = await render(post);
const { title, date, author, cover, coverAlt, description } = post.data;
---

<BaseLayout lang={lang} title={title} description={description || undefined} alternates={{ [lang]: Astro.url.pathname }}>
  <article>
    <header class="section--yellow head">
      <div class="container narrow">
        <a class="back" href={url('news', lang)}>← {t(lang, 'news.latest')}</a>
        <h1>{title}</h1>
        <p class="meta">
          <time datetime={date.toISOString()}>{formatDate(date, lang)}</time> · {t(lang, 'news.by')} {author}
        </p>
      </div>
    </header>
    <div class="container narrow body">
      {cover && <Image src={cover} alt={coverAlt} widths={[700, 1100, 1500]} sizes="(min-width: 800px) 760px, 100vw" class="cover" />}
      <div class="prose">
        <Content />
      </div>
    </div>
  </article>
  <DonateBand lang={lang} />
</BaseLayout>

<style>
  .head {
    padding-block: clamp(32px, 6vw, 72px);
  }

  .head h1 {
    font-size: clamp(1.8rem, 5vw, 3.2rem);
  }

  .back {
    display: inline-block;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .meta {
    margin: 0;
  }

  .body {
    padding-block: 40px 72px;
  }

  .cover {
    width: 100%;
    border-radius: var(--radius);
    margin-bottom: 32px;
  }
</style>

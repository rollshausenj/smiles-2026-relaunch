---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/blog';
import { links, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const own = await getPosts(lang);
const fallback = lang === 'en' && own.length === 0;
const posts = fallback ? await getPosts('de') : own;

const c = {
  de: {
    title: 'Aktuelles',
    lead: 'Meilensteine, Aktionen und Geschichten aus Mainz und Nairobi. Noch mehr gibt es täglich auf Instagram.',
  },
  en: {
    title: 'News',
    lead: 'Milestones, campaigns and stories from Mainz and Nairobi. Follow us on Instagram for daily updates.',
  },
}[lang];
---

<BaseLayout lang={lang} title={c.title} routeKey="news">
  <PageHero title={c.title} lead={c.lead}>
    <div class="actions">
      <a class="btn btn--dark" href={links.instagramDe} rel="noopener">Instagram DE</a>
      <a class="btn btn--ghost" href={links.instagramKe} rel="noopener">Instagram KE</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      {fallback && <p class="lead">{t(lang, 'news.empty')}</p>}
      <div class="grid grid--3">
        {posts.map((post) => <PostCard post={post} lang={lang} />)}
      </div>
    </div>
  </section>
</BaseLayout>

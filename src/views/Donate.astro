---
import BaseLayout from '../layouts/BaseLayout.astro';
import StillHero from '../components/StillHero.astro';
import still from '../assets/stills/lachen.jpg';
import Todo from '../components/Todo.astro';
import { links, org, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const c = {
  de: {
    label: 'Spenden',
    title: 'Schenk',
    highlight: 'Zukunft.',
    lead: 'Deine Spende finanziert Schulgebühren, Material und Mentoring – bis zum Abschluss. Einmalig oder monatlich, sicher über betterplace.org.',
    cta: 'Spenden über betterplace',
    impactLabel: '01 — Wirkung',
    impactNum: '10 €',
    impactText: 'decken das Schreibpapier für eine:n Schüler:in der Sekundarstufe – ein ganzes Jahr lang.',
    impactTodo: 'Weitere belegte Beispielbeträge vom Vorstand (Uniform, Schulgebühren pro Term, Internat).',
    bankLabel: '02 — Überweisung',
    bankText: 'Für eine Zuwendungsbestätigung gib bitte deine Adresse im Verwendungszweck an.',
    copy: 'Kopieren',
    copied: 'Kopiert',
    faqLabel: '03 — FAQ',
    faq: [
      ['Ist meine Spende steuerlich absetzbar?', 'Ja. Bei Spenden über betterplace.org erhältst du die Zuwendungsbestätigung automatisch von dort.'],
      ['Wohin geht mein Geld?', 'In einen gemeinsamen Topf, damit alle Stipendiat:innen bekommen, was sie brauchen: Schulgebühren, Uniformen, Material, Mentoring und – wenn nötig – Nachhilfe.'],
      ['Kann ich regelmäßig spenden?', 'Ja, auf betterplace.org kannst du eine monatliche oder jährliche Spende einrichten. Das gibt uns Planungssicherheit für mehrjährige Bildungswege.'],
    ],
    docsTodo: 'Transparenz: Jahresbericht 2025, Satzung und Freistellungsbescheid als PDF verlinken.',
  },
  en: {
    label: 'Donate',
    title: 'Give a',
    highlight: 'future.',
    lead: 'Your donation pays school fees, materials and mentoring – until graduation. One-off or monthly, securely via betterplace.org.',
    cta: 'Donate via betterplace',
    impactLabel: '01 — Impact',
    impactNum: '€10',
    impactText: 'covers writing paper for one secondary school student – for a whole year.',
    impactTodo: 'More verified example amounts from the board (uniform, fees per term, boarding school).',
    bankLabel: '02 — Bank transfer',
    bankText: 'For a German tax receipt, please add your address to the payment reference.',
    copy: 'Copy',
    copied: 'Copied',
    faqLabel: '03 — FAQ',
    faq: [
      ['Is my donation tax-deductible?', 'Yes, in Germany. betterplace.org automatically sends a receipt for donations made there.'],
      ['Where does my money go?', 'Into a shared pool so every scholar gets what they need: school fees, uniforms, materials, mentoring and tutoring where necessary.'],
      ['Can I donate regularly?', 'Yes, betterplace.org lets you set up a monthly or yearly donation. That helps us plan multi-year education paths.'],
    ],
    docsTodo: 'Transparency: link annual report 2025, statutes and tax-exemption notice as PDFs.',
  },
}[lang];
---

<BaseLayout lang={lang} title={c.label} routeKey="donate">
  <StillHero image={still} focus="center 35%" label={c.label} title={c.title} highlight={c.highlight} lead={c.lead}>
    <div class="actions">
      <a class="btn btn--accent big" href={links.betterplaceDonate} rel="noopener">{c.cta} <span class="arrow">↗</span></a>
    </div>
  </StillHero>

  <section class="section">
    <div class="container split">
      <p class="label" data-reveal>{c.impactLabel}</p>
      <div data-reveal>
        <p class="impact"><span class="accent">{c.impactNum}</span> {c.impactText}</p>
        <Todo>{c.impactTodo}</Todo>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <p class="label" data-reveal>{c.bankLabel}</p>
      <div class="card bank" data-reveal>
        <dl>
          <dt>{lang === 'de' ? 'Empfänger' : 'Recipient'}</dt>
          <dd>{org.name}</dd>
          <dt>IBAN</dt>
          <dd><code>{org.iban}</code> <button type="button" class="copy" data-copy={org.iban.replaceAll(' ', '')} data-done={c.copied}>{c.copy}</button></dd>
          <dt>BIC</dt>
          <dd><code>{org.bic}</code></dd>
        </dl>
        <p class="note">{c.bankText}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <p class="label" data-reveal>{c.faqLabel}</p>
      <div data-reveal>
        {
          c.faq.map(([q, a]) => (
            <details class="faq">
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))
        }
        <Todo>{c.docsTodo}</Todo>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .big {
    min-height: 60px;
    font-size: 1.05rem;
    padding-inline: 2em;
  }

  .impact {
    font-size: clamp(1.6rem, 3.6vw, 2.8rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .impact .accent {
    font-weight: 700;
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px 24px;
    margin: 0;
    align-items: center;
  }

  dt {
    font-family: var(--mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    color: var(--muted);
  }

  dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }

  code {
    font-family: var(--mono);
    font-size: clamp(0.9rem, 2.2vw, 1.15rem);
  }

  .copy {
    font: inherit;
    font-family: var(--mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--accent);
    cursor: pointer;
  }

  .note {
    margin: 24px 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .faq {
    border-bottom: 1px solid var(--line);
  }

  .faq summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 0;
    font-weight: 700;
    font-size: 1.15rem;
    cursor: pointer;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq summary::after {
    content: '+';
    font-family: var(--mono);
    color: var(--accent);
    transition: transform 0.3s var(--ease);
  }

  .faq[open] summary::after {
    transform: rotate(45deg);
  }

  .faq p {
    color: var(--muted);
    margin: 0 0 24px;
    max-width: 60ch;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      await navigator.clipboard.writeText(btn.dataset.copy ?? '');
      const label = btn.textContent;
      btn.textContent = btn.dataset.done ?? '✓';
      setTimeout(() => (btn.textContent = label), 1600);
    });
  });
</script>

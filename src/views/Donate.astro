---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Todo from '../components/Todo.astro';
import { links, org, url, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const c = {
  de: {
    title: 'Spenden',
    heroTitle: 'Schenk Zukunft',
    lead: 'Mit deiner Spende finanzierst du Schulgebühren, Material und Mentoring für Kinder und Jugendliche aus Korogocho – bis zum Abschluss ihres Bildungswegs.',
    cta: 'Jetzt über betterplace spenden',
    ctaNote: 'Einmalig oder als Dauerspende. Die Zuwendungsbestätigung erhältst du automatisch über betterplace.org.',
    impactTitle: 'Was deine Spende bewirkt',
    impact: [
      { amount: '10 €', text: 'Schreibpapier für eine:n Schüler:in der Sekundarstufe – für ein ganzes Jahr.' },
    ],
    impactTodo: 'Weitere belegte Beispielbeträge (z. B. Schuluniform, Schulgebühren pro Term, Internat) vom Vorstand.',
    bankTitle: 'Lieber per Überweisung?',
    bankText: 'Überweise direkt auf unser Vereinskonto. Für eine Zuwendungsbestätigung gib bitte deine Adresse im Verwendungszweck an oder schreib uns.',
    faqTitle: 'Häufige Fragen',
    faq: [
      { q: 'Ist meine Spende steuerlich absetzbar?', a: 'Ja. Smiles Africa e.V. ist als gemeinnützig anerkannt. Bei Spenden über betterplace.org bekommst du die Bestätigung von dort.' },
      { q: 'Wohin genau geht mein Geld?', a: 'Spenden fließen in einen gemeinsamen Topf, damit alle Stipendiat:innen bekommen, was sie brauchen: Schulgebühren, Uniformen, Material, Mentoring und – wenn nötig – Nachhilfe.' },
      { q: 'Kann ich regelmäßig spenden?', a: 'Ja, auf betterplace.org kannst du eine monatliche oder jährliche Dauerspende einrichten. Gerade sie gibt uns Planungssicherheit für mehrjährige Bildungswege.' },
    ],
    transparency: 'Wie wir Spenden verwenden, zeigen wir auf unserer Transparenzseite.',
  },
  en: {
    title: 'Donate',
    heroTitle: 'Give a future',
    lead: 'Your donation pays school fees, materials and mentoring for children and young people from Korogocho – until they complete their education.',
    cta: 'Donate via betterplace',
    ctaNote: 'One-off or recurring. betterplace.org automatically sends a German tax receipt.',
    impactTitle: 'What your donation does',
    impact: [{ amount: '€10', text: 'Writing paper for one secondary school student – for a whole year.' }],
    impactTodo: 'More verified example amounts (school uniform, fees per term, boarding school) from the board.',
    bankTitle: 'Prefer a bank transfer?',
    bankText: 'Transfer directly to our association’s account. For a tax receipt, please add your address to the reference or email us.',
    faqTitle: 'FAQ',
    faq: [
      { q: 'Is my donation tax-deductible?', a: 'Yes, in Germany. Smiles Africa e.V. is a registered non-profit. Donations via betterplace.org receive a receipt from there.' },
      { q: 'Where exactly does my money go?', a: 'Donations go into a shared pool so that every scholar gets what they need: school fees, uniforms, materials, mentoring and tutoring where necessary.' },
      { q: 'Can I donate regularly?', a: 'Yes, betterplace.org lets you set up a monthly or yearly donation. Recurring gifts help us plan multi-year education paths.' },
    ],
    transparency: 'See how we use donations on our transparency page.',
  },
}[lang];
---

<BaseLayout lang={lang} title={c.title} routeKey="donate">
  <PageHero title={c.heroTitle} lead={c.lead}>
    <div class="actions">
      <a class="btn btn--dark" href={links.betterplaceDonate} rel="noopener">{c.cta}</a>
    </div>
    <p class="note">{c.ctaNote}</p>
  </PageHero>

  <section class="section">
    <div class="container grid grid--2">
      <div>
        <h2>{c.impactTitle}</h2>
        <ul class="impact">
          {c.impact.map((i) => <li><strong>{i.amount}</strong><span>{i.text}</span></li>)}
        </ul>
        <Todo label={lang === 'de' ? 'Inhalt folgt' : 'Content pending'}>{c.impactTodo}</Todo>
      </div>
      <div class="bank">
        <h2>{c.bankTitle}</h2>
        <p>{c.bankText}</p>
        <dl>
          <dt>{lang === 'de' ? 'Empfänger' : 'Recipient'}</dt><dd>{org.name}</dd>
          <dt>IBAN</dt><dd><code>{org.iban}</code></dd>
          <dt>BIC</dt><dd><code>{org.bic}</code></dd>
        </dl>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container narrow">
      <h2>{c.faqTitle}</h2>
      {
        c.faq.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
      <p><a href={url('transparency', lang)}>{c.transparency}</a></p>
    </div>
  </section>
</BaseLayout>

<style>
  .note {
    font-size: 0.95rem;
    margin-top: 12px;
  }

  .impact {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .impact li {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 2px solid var(--line);
  }

  .impact strong {
    font-size: 2rem;
    font-stretch: 125%;
    min-width: 4ch;
  }

  .bank {
    background: var(--white);
    border: 2px solid var(--black);
    border-radius: var(--radius);
    padding: 24px;
  }

  dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 16px;
    margin: 0;
  }

  dt {
    font-weight: 700;
  }

  dd {
    margin: 0;
  }

  .faq {
    border-bottom: 2px solid var(--line);
    padding: 16px 0;
  }

  .faq summary {
    font-weight: 700;
    cursor: pointer;
  }

  .faq p {
    margin: 12px 0 0;
  }
</style>

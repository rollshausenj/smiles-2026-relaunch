---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { formatDate } from '../lib/blog';
import { links, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Inhalt pflegt das kenianische Team selbst in src/content/team-kenya/index.md (auf Englisch)
const page = await getEntry('teamKenya', 'index');
if (!page) throw new Error('src/content/team-kenya/index.md fehlt');
const { Content } = await render(page);
---

<BaseLayout lang={lang} title={page.data.title} routeKey="teamKenya">
  <PageHero eyebrow="Smiles Africa CLG · Nairobi" title={page.data.title}>
    <div class="actions">
      <a class="btn btn--dark" href={links.instagramKe} rel="noopener">Instagram @smilesafricacharity_ke</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container narrow">
      {lang === 'de' && <p class="note">Diese Seite wird vom kenianischen Team auf Englisch gepflegt.</p>}
      <div class="prose" lang="en">
        <Content />
      </div>
      {
        page.data.members.length > 0 && (
          <ul class="members" lang="en">
            {page.data.members.map((m) => (
              <li>
                <strong>{m.name}</strong>
                {m.role && <span>{m.role}</span>}
              </li>
            ))}
          </ul>
        )
      }
      {page.data.updated && <p class="note">Last updated: {formatDate(page.data.updated, 'en')}</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .note {
    color: var(--ink-muted);
    font-size: 0.95rem;
  }

  .members {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
  }

  .members li {
    display: flex;
    flex-direction: column;
    border-left: 6px solid var(--yellow);
    padding-left: 12px;
  }

  .members span {
    color: var(--ink-muted);
  }
</style>

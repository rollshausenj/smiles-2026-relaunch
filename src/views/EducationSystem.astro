---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Todo from '../components/Todo.astro';
import DonateBand from '../components/DonateBand.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Grundlage: Adventsreihe auf Instagram (Dezember 2025). Vor Veröffentlichung vom Team in Kenia prüfen lassen.
const c = {
  de: {
    title: 'Das kenianische Bildungssystem',
    lead: 'Bildung ist in Kenia oft eine Frage des Geldbeutels. Wir erklären, wie der Weg von der Grundschule bis zur Universität aussieht – und wo unsere Stipendien ansetzen.',
    stages: [
      ['Grundschule', 'In staatlichen Grundschulen fallen keine Schulgebühren an – Uniform, Schuhe, Bücher, Material und Mittagessen müssen Familien aber selbst bezahlen.'],
      ['Sekundarstufe (Klasse 7–12)', 'Hier werden aus Kindern junge Erwachsene, und hier entscheidet sich, welche Wege offenstehen. Schon kleine Beträge machen einen Unterschied: 10 € decken das Schreibpapier für ein ganzes Jahr.'],
      ['Internat', 'Internate geben Jugendlichen die Chance, sich ganz auf ihre Bildung zu konzentrieren – mit sicheren Mahlzeiten, einem eigenen Bett und fern von den Risiken des Lebens im Slum.'],
      ['Universität', 'Nach der 12. Klasse können Schüler:innen mit guten Noten studieren, meist drei Jahre bis zum Abschluss. Ein wichtiger, aber teurer Schritt.'],
    ],
    schoolsTitle: 'Warum Organisationsschulen?',
    schools: 'In Slum-Regionen fehlen staatliche Schulen. Private „Schulen“ sind dort oft Blechhütten mit unqualifiziertem Personal. Schulen, die von Kirchen oder Vereinen getragen werden, haben studierte Lehrkräfte – aber höhere Gebühren. Dorthin bringen wir unsere Stipendiat:innen: Qualität vor Quantität.',
    todo: 'Inhalte vom kenianischen Team auf den aktuellen Stand des Schulsystems prüfen lassen.',
  },
  en: {
    title: 'Kenya’s education system',
    lead: 'In Kenya, education often depends on money. Here is what the path from primary school to university looks like – and where our scholarships come in.',
    stages: [
      ['Primary school', 'Public primary schools charge no fees – but families must pay for uniforms, shoes, books, materials and lunch themselves.'],
      ['Secondary school (grades 7–12)', 'This is where children grow into young adults and where their options are decided. Small amounts make a difference: €10 covers writing paper for a whole year.'],
      ['Boarding school', 'Boarding schools let young people focus fully on their education – with reliable meals, their own bed and away from the risks of slum life.'],
      ['University', 'After grade 12, students with good grades can go to university, usually for three years. An important but expensive step.'],
    ],
    schoolsTitle: 'Why organisation-run schools?',
    schools: 'Slum areas lack public schools. Private “schools” there are often tin shacks with unqualified staff. Schools run by churches or associations have trained teachers – but higher fees. That is where we place our scholars: quality over quantity.',
    todo: 'Have the Kenyan team review the content against the current school system.',
  },
}[lang];
---

<BaseLayout lang={lang} title={c.title} routeKey="education">
  <PageHero title={c.title} lead={c.lead} />

  <section class="section">
    <div class="container narrow">
      <ol class="stages">
        {
          c.stages.map(([title, text]) => (
            <li>
              <h2>{title}</h2>
              <p>{text}</p>
            </li>
          ))
        }
      </ol>
      <h2>{c.schoolsTitle}</h2>
      <p>{c.schools}</p>
      <Todo label={lang === 'de' ? 'Prüfen' : 'Review'}>{c.todo}</Todo>
    </div>
  </section>

  <DonateBand lang={lang} />
</BaseLayout>

<style>
  .stages {
    list-style: none;
    margin: 0 0 48px;
    padding: 0;
    counter-reset: stage;
  }

  .stages li {
    position: relative;
    padding: 0 0 32px 72px;
    border-left: 4px solid var(--yellow);
    margin-left: 24px;
    counter-increment: stage;
  }

  .stages li::before {
    content: counter(stage);
    position: absolute;
    left: -26px;
    top: -4px;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--black);
    color: var(--yellow);
    font-weight: 800;
    font-size: 1.3rem;
  }

  .stages h2 {
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
  }
</style>

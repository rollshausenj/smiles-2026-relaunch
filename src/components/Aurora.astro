---
/**
 * Aurora / Fluid Gradient: mehrere weichgezeichnete Farbflächen, die langsam treiben.
 * Liegt absolut im nächsten positionierten Elternelement. Reine CSS-Animation, kein JS.
 */
interface Props {
  /** Stärke der Farbe, 0–1 */
  intensity?: number;
  class?: string;
}
const { intensity = 1, class: className } = Astro.props;
---

<div class:list={['aurora', className]} style={`--aurora-o: ${intensity}`} aria-hidden="true">
  <span class="b1"></span>
  <span class="b2"></span>
  <span class="b3"></span>
  <span class="b4"></span>
</div>

<style>
  .aurora {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: var(--aurora-o);
    filter: blur(70px) saturate(140%);
  }

  .aurora span {
    position: absolute;
    border-radius: 50%;
    mix-blend-mode: screen;
    will-change: transform;
  }

  /* Markengelb */
  .b1 {
    width: 55vmax;
    height: 45vmax;
    left: -10%;
    top: -20%;
    background: radial-gradient(closest-side, rgb(238 226 6 / 0.55), transparent);
    animation: drift1 22s ease-in-out infinite alternate;
  }

  /* warmes Amber */
  .b2 {
    width: 45vmax;
    height: 40vmax;
    right: -15%;
    top: 0%;
    background: radial-gradient(closest-side, rgb(255 138 0 / 0.38), transparent);
    animation: drift2 26s ease-in-out infinite alternate;
  }

  /* kühles Türkis als Gegenpol */
  .b3 {
    width: 50vmax;
    height: 40vmax;
    left: 20%;
    bottom: -30%;
    background: radial-gradient(closest-side, rgb(0 196 170 / 0.32), transparent);
    animation: drift3 30s ease-in-out infinite alternate;
  }

  /* Limette */
  .b4 {
    width: 30vmax;
    height: 30vmax;
    right: 15%;
    bottom: -10%;
    background: radial-gradient(closest-side, rgb(170 230 60 / 0.3), transparent);
    animation: drift4 24s ease-in-out infinite alternate;
  }

  @keyframes drift1 {
    to {
      transform: translate(18vw, 12vh) scale(1.15) rotate(20deg);
    }
  }

  @keyframes drift2 {
    to {
      transform: translate(-20vw, 18vh) scale(0.9) rotate(-15deg);
    }
  }

  @keyframes drift3 {
    to {
      transform: translate(-12vw, -22vh) scale(1.2);
    }
  }

  @keyframes drift4 {
    to {
      transform: translate(-25vw, -10vh) scale(1.3);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora span {
      animation: none;
    }
  }
</style>

---
import { Image } from 'astro:assets';
import logo from '../assets/img/logo.png';
import { languages, nav, routes, t, url, type Lang, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Lang;
  current: RouteKey;
}

const { lang, current } = Astro.props;
const other: Lang = lang === 'de' ? 'en' : 'de';
// Digital Empowerment und Hygiene sind Unterseiten von „Projekt“
const section: RouteKey = current === 'digital' || current === 'hygiene' ? 'project' : current;
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href={url('home', lang)} aria-label={t(lang, 'site.title')}>
      <Image src={logo} alt="" width={44} height={44} loading="eager" />
      <span>Smiles Africa</span>
    </a>

    <nav class="desktop" aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
      {
        nav.map((item) => (
          <a href={url(item.key, lang)} aria-current={item.key === section ? 'page' : undefined}>
            {item.label[lang]}
          </a>
        ))
      }
    </nav>

    <div class="tools">
      <a class="lang" href={routes[current][other]} hreflang={other} lang={other} title={languages[other]}>
        {other.toUpperCase()}
      </a>
      <a class="btn btn--accent donate" href={url('donate', lang)}>{t(lang, 'cta.donate')}</a>
      <button class="burger" type="button" aria-expanded="false" aria-controls="mobile-nav">
        <span class="visually-hidden">{t(lang, 'nav.menu')}</span>
        <span class="lines" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile" hidden aria-label={lang === 'de' ? 'Hauptnavigation' : 'Main navigation'}>
    <a href={url('home', lang)}>Home</a>
    {nav.map((item) => <a href={url(item.key, lang)}>{item.label[lang]}</a>)}
    <a href={url('donate', lang)} class="accent">{t(lang, 'cta.donate')} →</a>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 12px 12px auto;
    z-index: 50;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: calc(var(--max) - 2 * var(--gutter) + 48px);
    margin-inline: auto;
    padding: 8px 8px 8px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(11 11 12 / 0.65);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
  }

  .brand {
    font-family: var(--display);
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    flex-shrink: 0;
  }

  .brand img {
    width: 36px;
    height: 36px;
  }

  .desktop {
    display: flex;
    gap: 4px;
    margin-inline: auto;
  }

  .desktop a {
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 0.92rem;
    color: var(--muted);
    transition: color 0.2s, background-color 0.2s;
  }

  .desktop a:hover,
  .desktop a[aria-current='page'] {
    color: var(--text);
    background: var(--surface);
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }

  .lang {
    font-family: var(--mono);
    font-size: 0.8rem;
    padding: 8px 10px;
    color: var(--muted);
  }

  .lang:hover {
    color: var(--accent);
  }

  .donate {
    min-height: 42px;
    padding: 0.5em 1.2em;
    font-size: 0.88rem;
    white-space: nowrap;
  }

  .burger {
    display: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }

  .lines,
  .lines::before {
    display: block;
    width: 16px;
    height: 1.5px;
    margin: auto;
    background: currentColor;
    transition: transform 0.3s var(--ease);
  }

  .lines {
    position: relative;
    transform: translateY(-3px);
  }

  .lines::before {
    content: '';
    position: absolute;
    top: 6px;
  }

  .burger[aria-expanded='true'] .lines {
    transform: rotate(45deg);
  }

  .burger[aria-expanded='true'] .lines::before {
    transform: translateY(-6px) rotate(-90deg);
  }

  .mobile {
    display: flex;
    flex-direction: column;
    margin-top: 8px;
    padding: 16px 24px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: rgb(11 11 12 / 0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .mobile[hidden] {
    display: none;
  }

  .mobile a {
    font-family: var(--display);
    padding: 14px 0;
    font-size: 1.6rem;
    font-weight: 700;
    text-transform: uppercase;
    border-bottom: 1px solid var(--line);
  }

  .mobile a:last-child {
    border-bottom: 0;
  }

  @media (max-width: 899px) {
    .desktop {
      display: none;
    }

    .burger {
      display: grid;
      place-items: center;
    }
  }

  @media (max-width: 420px) {
    .brand span {
      display: none;
    }
  }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('.burger');
  const menu = document.getElementById('mobile-nav');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
</script>

---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { eyebrow, title, lead, image, imageAlt = '' } = Astro.props;
---

<section class="hero section--yellow">
  <div class="container hero-grid" class:list={{ 'has-image': image }}>
    <div>
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1>{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {
      image && (
        <Image src={image} alt={imageAlt} widths={[480, 800, 1200]} sizes="(min-width: 900px) 50vw, 100vw" loading="eager" />
      )
    }
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(40px, 7vw, 88px);
  }

  .hero-grid {
    display: grid;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
  }

  @media (min-width: 900px) {
    .hero-grid.has-image {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .hero img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    border: 3px solid var(--black);
  }
</style>

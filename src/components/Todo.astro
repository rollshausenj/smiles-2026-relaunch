---
/** Sichtbarer Platzhalter für Inhalte, die noch geliefert werden. Vor dem Relaunch alle entfernen. */
interface Props {
  label?: string;
}
const { label = 'TODO' } = Astro.props;
---

<aside class="todo" data-todo>
  <span>{label}</span>
  <slot />
</aside>

<style>
  .todo {
    display: flex;
    gap: 12px;
    align-items: baseline;
    border: 1px dashed rgb(238 226 6 / 0.5);
    background: rgb(238 226 6 / 0.06);
    color: var(--muted);
    border-radius: 12px;
    padding: 12px 16px;
    margin-block: 1.5rem;
    font-size: 0.9rem;
  }

  span {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--accent);
    flex-shrink: 0;
  }
</style>

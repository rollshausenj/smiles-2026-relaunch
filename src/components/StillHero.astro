---
/**
 * Seitenkopf: großes Schwarzweiß-Standbild (wie auf der alten Seite), darüber ein Aurora-Gradient
 * und der Seitentitel. Ohne Bild bleibt nur der Gradient auf dunklem Grund.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Aurora from './Aurora.astro';

interface Props {
  label: string;
  title: string;
  /** Wird gelb hervorgehoben in einer neuen Zeile angehängt */
  highlight?: string;
  lead?: string;
  image?: ImageMetadata;
  /** Bildausschnitt, z. B. "center 30%" */
  focus?: string;
  /** Volle Bildschirmhöhe (Startseite) */
  full?: boolean;
}

const { label, title, highlight, lead, image, focus = 'center', full = false } = Astro.props;
---

<section class:list={['still', { full, 'no-image': !image }]}>
  {
    image && (
      <Image
        class="bg"
        src={image}
        alt=""
        widths={[800, 1400, 2000, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        style={`object-position: ${focus}`}
      />
    )
  }
  <div class="shade" aria-hidden="true"></div>
  <Aurora intensity={image ? 0.85 : 1} />
  <div class="container content">
    <p class="label" data-reveal>{label}</p>
    <h1 data-reveal>
      {title}
      {highlight && (
        <>
          <br />
          <span class="accent">{highlight}</span>
        </>
      )}
    </h1>
    {lead && <p class="lead" data-reveal>{lead}</p>}
    <div data-reveal><slot /></div>
  </div>
</section>

<style>
  .still {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: min(78svh, 760px);
    padding-block: 160px clamp(56px, 8vw, 96px);
    overflow: hidden;
    isolation: isolate;
    background: var(--bg);
  }

  .still.full {
    min-height: 100svh;
  }

  .still.no-image {
    min-height: auto;
    padding-top: clamp(150px, 20vw, 220px);
  }

  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    filter: grayscale(1) contrast(1.1) brightness(0.85);
  }

  /* Abdunkeln nach unten, damit der Text immer lesbar ist */
  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, var(--bg) 0%, rgb(11 11 12 / 0.82) 30%, rgb(11 11 12 / 0.55) 60%, rgb(11 11 12 / 0.3) 85%, rgb(11 11 12 / 0.55) 100%),
      linear-gradient(to right, rgb(11 11 12 / 0.55), transparent 70%);
  }

  .still :global(.aurora) {
    z-index: -1;
    mix-blend-mode: soft-light;
  }

  .no-image :global(.aurora) {
    mix-blend-mode: normal;
    opacity: 0.9;
  }

  .content {
    position: relative;
  }

  .lead {
    color: rgb(243 243 241 / 0.82);
  }
</style>

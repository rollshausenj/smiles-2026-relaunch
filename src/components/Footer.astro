---
import { links, org, t, url, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container cols">
    <div>
      <p class="claim display">{t(lang, 'site.claim')}</p>
      <a class="btn btn--primary" href={url('donate', lang)}>{t(lang, 'cta.donate')}</a>
    </div>
    <div>
      <h2>{t(lang, 'footer.contactDe')}</h2>
      <p>
        {org.name}<br />
        {org.street}<br />
        {org.city}<br />
        <a href={`mailto:${links.email}`}>{links.email}</a>
      </p>
    </div>
    <div>
      <h2>{t(lang, 'footer.contactKe')}</h2>
      <p>
        {org.kenya.name}<br />
        {org.kenya.contact}<br />
        {org.kenya.address}
      </p>
    </div>
    <div>
      <h2>{t(lang, 'footer.bank')}</h2>
      <p>
        {org.name}<br />
        IBAN: {org.iban}<br />
        BIC: {org.bic}
      </p>
      <h2>{t(lang, 'footer.follow')}</h2>
      <ul class="social">
        <li><a href={links.instagramDe} rel="noopener">Instagram DE</a></li>
        <li><a href={links.instagramKe} rel="noopener">Instagram KE</a></li>
        <li><a href={links.facebook} rel="noopener">Facebook</a></li>
      </ul>
    </div>
  </div>
  <div class="container legal">
    <span>© {year} {org.name}</span>
    <a href={url('imprint', lang)}>{lang === 'de' ? 'Impressum' : 'Imprint'}</a>
    <a href={url('privacy', lang)}>{lang === 'de' ? 'Datenschutz' : 'Privacy'}</a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--black);
    color: #e8e8e8;
    padding-top: clamp(48px, 7vw, 80px);
    font-size: 0.95rem;
  }

  .cols {
    display: grid;
    gap: 32px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
  }

  .claim {
    color: var(--yellow);
    font-size: 1.6rem;
    margin-bottom: 1rem;
  }

  h2 {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--yellow);
    margin-bottom: 0.6em;
  }

  .social {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 40px;
    padding-block: 24px;
    border-top: 1px solid #2c2c2c;
    font-size: 0.85rem;
    color: #b5b5b5;
  }
</style>

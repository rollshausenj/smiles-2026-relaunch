---
import { links, org, t, url, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const de = lang === 'de';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <a class="big" href={url('donate', lang)}>
      <span>{de ? 'Gleiche Chancen' : 'Equal chances'}</span>
      <span class="accent">{de ? 'für alle Kinder →' : 'for every child →'}</span>
    </a>

    <div class="cols">
      <div>
        <p class="label">{t(lang, 'footer.contactDe')}</p>
        <p>{org.name}<br />{org.street}<br />{org.city}</p>
        <a class="link" href={`mailto:${links.email}`}>{links.email}</a>
      </div>
      <div>
        <p class="label">{t(lang, 'footer.contactKe')}</p>
        <p>{org.kenya.name}<br />{org.kenya.contact}<br />{org.kenya.address}</p>
      </div>
      <div>
        <p class="label">{t(lang, 'footer.bank')}</p>
        <p class="mono">{org.iban}<br />BIC {org.bic}</p>
      </div>
      <div>
        <p class="label">{t(lang, 'footer.follow')}</p>
        <ul>
          <li><a href={links.instagramDe} rel="noopener">Instagram DE ↗</a></li>
          <li><a href={links.instagramKe} rel="noopener">Instagram KE ↗</a></li>
          <li><a href={links.facebook} rel="noopener">Facebook ↗</a></li>
        </ul>
      </div>
    </div>

    <div class="legal">
      <span>© {year} {org.name}</span>
      <span class="spacer"></span>
      <a href={url('imprint', lang)}>{de ? 'Impressum' : 'Imprint'}</a>
      <a href={url('privacy', lang)}>{de ? 'Datenschutz' : 'Privacy'}</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding-top: clamp(64px, 10vw, 128px);
    color: var(--muted);
    font-size: 0.95rem;
  }

  .big {
    display: flex;
    flex-direction: column;
    font-size: clamp(2.2rem, 7vw, 5.5rem);
    font-weight: 800;
    font-stretch: 125%;
    text-transform: uppercase;
    line-height: 0.95;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: clamp(48px, 8vw, 96px);
  }

  .big:hover .accent {
    text-decoration: underline;
    text-decoration-thickness: 4px;
    text-underline-offset: 8px;
  }

  .cols {
    display: grid;
    gap: 32px;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
  }

  .cols a:hover {
    color: var(--text);
  }

  .label {
    margin-bottom: 0.75rem;
  }

  .mono {
    font-family: var(--mono);
    font-size: 0.85rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    line-height: 2;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin-top: 64px;
    padding-block: 24px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 0.78rem;
  }

  .spacer {
    flex: 1;
  }

  .legal a:hover {
    color: var(--text);
  }
</style>
